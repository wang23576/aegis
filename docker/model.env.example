# LLM model configuration for Aegis.
# Copy to model.env and fill in your own values. model.env is gitignored (contains secrets).
# Values follow paw's TalkwebModelConfig (OpenAI-compatible gateway).
AEGIS_MODEL_BASE_URL=https://llm.talkweb.com.cn
AEGIS_MODEL_NAME=gpu-qwen3.8-27b
AEGIS_MODEL_API_KEY=replace-with-your-api-key

# web_search search provider (same as paw; read directly by agentscope-harness WebSearchTool).
# AnySearch takes priority (Bearer auth, response data.results). Leave the key empty to
# fall back to Tavily (requires TAVILY_API_KEY).
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=https://api.anysearch.com/v1/search
